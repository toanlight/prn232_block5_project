@model CloneEbay_FE.Models.CreateReturnRequestViewModel
@{
    ViewData["Title"] = "Gửi yêu cầu hoàn trả";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="simple-card">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-arrow-return-left text-primary me-2"></i>Gửi yêu cầu hoàn trả
                </h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-2">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>

            <div class="alert alert-info border-0 rounded-3 mb-4 small">
                <i class="bi bi-info-circle-fill me-2"></i>
                Lưu ý: Chỉ các đơn hàng có trạng thái <strong>Delivered (Đã giao hàng)</strong> mới có thể tạo yêu cầu hoàn trả.
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="OrderId" class="form-label">Mã Đơn Hàng (Order ID)</label>
                    <input asp-for="OrderId" class="form-control" placeholder="Nhập ID đơn hàng (Ví dụ: 1)" />
                    <span asp-validation-for="OrderId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Reason" class="form-label">Lý do hoàn trả sản phẩm</label>
                    <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Mô tả lý do hoàn trả (Sản phẩm bị lỗi, không đúng mô tả, bể vỡ...)"></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-main">
                    <i class="bi bi-send-fill me-1"></i> Gửi yêu cầu hoàn trả
                </button>
            </form>
        </div>
    </div>
</div>
