@model CloneEbay_FE.Models.CreateReturnRequestViewModel
@{
    ViewData["Title"] = "Gửi yêu cầu hoàn trả sản phẩm (eBay Return & Refund)";
    var deliveredOrders = ViewBag.DeliveredOrders as List<CloneEbay_FE.Models.OrderViewModel> ?? new();
}

<div class="row justify-content-center py-4">
    <div class="col-md-9 col-lg-8">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h4 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-arrow-return-left text-primary me-2"></i>Tạo Yêu Cầu Hoàn Trả & Hoàn Tiền
                    </h4>
                    <p class="text-muted small mb-0">Theo chính sách Đảm bảo Hoàn tiền của eBay (eBay Money Back Guarantee)</p>
                </div>
                <a asp-controller="Profile" asp-action="Orders" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Đơn mua của tôi
                </a>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4 small"></div>

                    <!-- Step 1: Select Order & Return Scope -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark fs-6 mb-2">
                            <span class="badge bg-primary rounded-circle me-1">1</span> Chọn Đơn Hàng & Phạm Vi Hoàn Trả
                        </label>
                        @if (deliveredOrders.Any())
                        {
                            <div class="border rounded-3 p-3 bg-light">
                                <label asp-for="OrderId" class="form-label small text-muted">Chọn đơn hàng:</label>
                                <select id="orderSelect" asp-for="OrderId" class="form-select border-0 shadow-sm mb-3">
                                    <option value="">-- Chọn đơn hàng đã giao thành công --</option>
                                    @foreach (var o in deliveredOrders)
                                    {
                                        <option value="@o.Id" selected="@(Model.OrderId == o.Id ? "selected" : null)">
                                            Đơn hàng #@o.Id - Ngày: @(o.OrderDate?.ToString("dd/MM/yyyy") ?? "N/A") - Tổng: @o.TotalPrice.ToString("N0") ₫
                                        </option>
                                    }
                                </select>

                                @foreach (var o in deliveredOrders)
                                {
                                    <div class="order-items-group d-none" id="order-items-@o.Id">
                                        <!-- Scope Radio Toggle -->
                                        <div class="mb-3 p-3 bg-white border rounded-3">
                                            <label class="form-label fw-bold text-dark small mb-2 d-block">Hình thức hoàn trả:</label>
                                            <div class="form-check form-check-inline me-4">
                                                <input class="form-check-input return-scope-radio" type="radio" name="scope_@o.Id" id="scope_single_@o.Id" value="single" checked data-order-id="@o.Id">
                                                <label class="form-check-input-label fw-semibold text-dark small cursor-pointer" for="scope_single_@o.Id">
                                                    Chọn các sản phẩm cụ thể trong đơn
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input return-scope-radio" type="radio" name="scope_@o.Id" id="scope_entire_@o.Id" value="entire" data-order-id="@o.Id">
                                                <label class="form-check-input-label fw-semibold text-danger small cursor-pointer" for="scope_entire_@o.Id">
                                                    Trả TOÀN BỘ sản phẩm trong đơn hàng
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Hidden Input for ReturnEntireOrder -->
                                        <input type="hidden" name="ReturnEntireOrder" id="entireOrderInput-@o.Id" value="false" />

                                        <!-- Items List with Checkboxes -->
                                        <div id="itemsContainer-@o.Id">
                                            <label class="form-label small text-muted fw-semibold">Tích chọn các sản phẩm bạn muốn hoàn trả:</label>
                                            <div class="list-group shadow-sm rounded-3 mb-2">
                                                @foreach (var item in o.Items)
                                                {
                                                    var isChecked = Model.OrderItemId == item.Id || (Model.SelectedOrderItemIds != null && Model.SelectedOrderItemIds.Contains(item.Id));
                                                    <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 cursor-pointer">
                                                        <input type="checkbox" name="SelectedOrderItemIds" value="@item.Id" class="form-check-input flex-shrink-0 item-checkbox-@o.Id" @(isChecked ? "checked" : "") />
                                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                        {
                                                            <img src="@item.ImageUrl" alt="@item.ProductTitle" class="rounded-3 border" style="width: 54px; height: 54px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-secondary text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                                                                <i class="bi bi-box"></i>
                                                            </div>
                                                        }
                                                        <div class="flex-grow-1">
                                                            <div class="fw-semibold text-dark mb-1">@item.ProductTitle</div>
                                                            <div class="text-muted small">
                                                                Đơn giá: <span class="text-danger fw-bold">@item.UnitPrice.ToString("N0") ₫</span> | Số lượng: x@(item.Quantity)
                                                            </div>
                                                        </div>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning border-0 rounded-3 mb-0">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Bạn chưa có đơn hàng nào ở trạng thái <strong>Delivered (Đã giao)</strong> để thực hiện yêu cầu hoàn trả.
                            </div>
                        }
                        <span asp-validation-for="OrderId" class="text-danger small"></span>
                    </div>

                    <!-- Step 2: Return Reason Category -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark fs-6 mb-2">
                            <span class="badge bg-primary rounded-circle me-1">2</span> Chọn Lý Do Hoàn Trả (Chuẩn eBay)
                        </label>
                        <select asp-for="SelectedReasonCategory" class="form-select rounded-3 py-2">
                            <option value="">-- Chọn lý do phù hợp --</option>
                            <option value="Sản phẩm bị hư hỏng / nứt vỡ">Sản phẩm bị hư hỏng / nứt vỡ khi vận chuyển (Damaged)</option>
                            <option value="Sản phẩm bị lỗi kỹ thuật">Sản phẩm bị lỗi kỹ thuật / không hoạt động (Defective)</option>
                            <option value="Giao sai sản phẩm">Giao sai sản phẩm / không đúng mẫu mã (Wrong Item)</option>
                            <option value="Không đúng mô tả / khác hình ảnh">Sản phẩm không đúng mô tả / khác hình ảnh (Not As Described)</option>
                            <option value="Thay đổi nhu cầu / Không vừa">Thay đổi nhu cầu / Không vừa kích thước (Changed Mind)</option>
                        </select>
                        <span asp-validation-for="SelectedReasonCategory" class="text-danger small"></span>
                    </div>

                    <!-- Step 3: Detailed Explanation -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark fs-6 mb-2">
                            <span class="badge bg-primary rounded-circle me-1">3</span> Mô Tả Chi Tiết Lý Do Hoàn Trả
                        </label>
                        <textarea asp-for="DetailedReason" class="form-control rounded-3 p-3" rows="4" placeholder="Cung cấp thêm chi tiết về tình trạng sản phẩm (Ví dụ: Máy không lên nguồn, vỏ hộp bị móp xước nặng...)"></textarea>
                        <span asp-validation-for="DetailedReason" class="text-danger small"></span>
                    </div>

                    <!-- Step 4: Evidence Photos Upload -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark fs-6 mb-2">
                            <span class="badge bg-primary rounded-circle me-1">4</span> Tải Ảnh Bằng Chứng (Rất khuyến khích cho hàng lỗi/vỡ)
                        </label>
                        <div class="border border-dashed rounded-3 p-4 text-center bg-light">
                            <i class="bi bi-cloud-arrow-up display-5 text-primary mb-2 d-block"></i>
                            <div class="fw-semibold text-dark mb-1">Tải lên danh sách ảnh bằng chứng chụp thực tế sản phẩm</div>
                            <div class="text-muted small mb-3">Hỗ trợ các định dạng .JPG, .PNG, .WEBP (Tối đa 5 ảnh)</div>
                            <input asp-for="EvidenceFiles" type="file" multiple class="form-control form-control-sm w-auto mx-auto" accept="image/*" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold py-3">
                            <i class="bi bi-send-fill me-2"></i> Gửi Yêu Cầu Hoàn Trả Ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const orderSelect = document.getElementById("orderSelect");
            if (!orderSelect) return;

            function showOrderItems(orderId) {
                document.querySelectorAll(".order-items-group").forEach(el => el.classList.add("d-none"));
                if (orderId) {
                    const target = document.getElementById("order-items-" + orderId);
                    if (target) {
                        target.classList.remove("d-none");
                    }
                }
            }

            orderSelect.addEventListener("change", function () {
                showOrderItems(this.value);
            });

            if (orderSelect.value) {
                showOrderItems(orderSelect.value);
            }

            document.querySelectorAll(".return-scope-radio").forEach(radio => {
                radio.addEventListener("change", function () {
                    const orderId = this.getAttribute("data-order-id");
                    const itemsContainer = document.getElementById("itemsContainer-" + orderId);
                    const entireInput = document.getElementById("entireOrderInput-" + orderId);

                    if (this.value === "entire") {
                        if (entireInput) entireInput.value = "true";
                        if (itemsContainer) {
                            itemsContainer.classList.add("opacity-50");
                            itemsContainer.querySelectorAll("input[type='checkbox']").forEach(cb => cb.checked = true);
                        }
                    } else {
                        if (entireInput) entireInput.value = "false";
                        if (itemsContainer) {
                            itemsContainer.classList.remove("opacity-50");
                        }
                    }
                });
            });
        });
    </script>
}
