@model List<CloneEbay_FE.Models.ReturnRequestViewModel>
@{
    ViewData["Title"] = "Quản lý yêu cầu hoàn trả đơn hàng";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-arrow-return-left text-primary me-2"></i>Quản lý yêu cầu hoàn trả
        </h3>
        <p class="text-muted small mb-0">Theo dõi trạng thái các đơn hàng cần hoàn trả/đổi trả sản phẩm.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3 px-3 py-2 fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Gửi yêu cầu mới
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="simple-card text-center py-5">
        <i class="bi bi-inbox text-muted display-4 mb-3 d-block"></i>
        <h5 class="fw-bold text-dark mb-1">Chưa có yêu cầu hoàn trả nào</h5>
        <p class="text-muted small mb-3">Bạn có thể tạo yêu cầu hoàn trả đối với các đơn hàng đã được giao thành công.</p>
        <a asp-action="Create" class="btn btn-outline-primary rounded-3 px-4">Gửi yêu cầu ngay</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            var badgeClass = item.Status switch
            {
                "Pending" => "bg-warning text-dark",
                "Approved" => "bg-success text-white",
                "Rejected" => "bg-danger text-white",
                "Cancelled" => "bg-secondary text-white",
                _ => "bg-info text-white"
            };

            var statusText = item.Status switch
            {
                "Pending" => "Chờ xử lý",
                "Approved" => "Đã chấp nhận",
                "Rejected" => "Đã từ chối",
                "Cancelled" => "Đã huỷ",
                _ => item.Status
            };

            <div class="col-12 col-md-6 col-lg-4">
                <div class="simple-card h-100 p-4 d-flex flex-column justify-content-between shadow-sm">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-dark fs-6">Đơn hàng #@item.OrderId</span>
                            <span class="badge @badgeClass px-2 py-1 fs-7">@statusText</span>
                        </div>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-calendar-event me-1"></i>Ngày tạo: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <span class="fw-semibold text-secondary d-block fs-7 mb-1">Lý do hoàn trả:</span>
                            <span class="text-dark small">@item.Reason</span>
                        </div>
                    </div>

                    <div class="pt-2 border-top d-flex align-items-center justify-content-between">
                        @if (item.Status == "Pending")
                        {
                            <form asp-action="Cancel" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-2 px-3" onclick="return confirm('Bạn có chắc chắn muốn huỷ yêu cầu này?');">
                                    <i class="bi bi-x-circle me-1"></i>Huỷ yêu cầu
                                </button>
                            </form>

                            <!-- Demo nút duyệt/từ chối cho Seller/Admin -->
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border dropdown-toggle rounded-2" type="button" data-bs-toggle="dropdown">
                                    Duyệt (Seller)
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <form asp-action="UpdateStatus" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="Approved" />
                                            <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i>Chấp nhận</button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-action="UpdateStatus" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="Rejected" />
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-2"></i>Từ chối</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fs-7">Mã yêu cầu: #@item.Id</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
