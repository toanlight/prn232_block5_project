@model CloneEbay_FE.Models.VerifyOtpViewModel
@{
    ViewData["Title"] = "Xác thực Email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card text-center">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-primary rounded-circle mb-3" style="width: 75px; height: 75px;">
                    <i class="bi bi-envelope-check fs-1"></i>
                </div>
                <h3 class="fw-bold">Xác thực tài khoản</h3>
                <p class="text-muted small">
                    Mã xác thực OTP gồm 6 chữ số đã được gửi đến địa chỉ email:
                    <br /><strong class="text-dark">@Model.Email</strong>
                </p>
            </div>

            <form asp-action="VerifyEmail" method="post" id="verifyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="OtpCode" class="form-label fw-semibold">Nhập mã OTP</label>
                    <input asp-for="OtpCode" class="form-control text-center fs-3 fw-bold letter-spacing-lg" 
                           placeholder="------" maxlength="6" autofocus style="letter-spacing: 8px;" />
                    <span asp-validation-for="OtpCode" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-ebay-primary w-100 py-2 fs-6 mb-3">
                    <i class="bi bi-patch-check me-1"></i> Xác nhận & Kích hoạt
                </button>
            </form>

            <div class="mt-3">
                <span class="text-muted small">Chưa nhận được mã?</span>
                <button type="button" id="resendBtn" class="btn btn-link text-primary p-0 small fw-semibold text-decoration-none ms-1">
                    Gửi lại mã OTP (<span id="timerText">60s</span>)
                </button>
                <div id="resendStatus" class="mt-2 small"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let countdown = 60;
        let resendBtn = document.getElementById('resendBtn');
        let timerText = document.getElementById('timerText');
        let timerInterval = null;

        function startTimer() {
            resendBtn.disabled = true;
            countdown = 60;
            timerText.innerText = countdown + 's';
            if (timerInterval) clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                countdown--;
                if (countdown <= 0) {
                    clearInterval(timerInterval);
                    resendBtn.disabled = false;
                    timerText.innerText = 'Gửi lại ngay';
                } else {
                    timerText.innerText = countdown + 's';
                }
            }, 1000);
        }

        startTimer();

        resendBtn.addEventListener('click', function () {
            if (countdown > 0) return;

            let email = document.querySelector('input[name="Email"]').value;
            let statusDiv = document.getElementById('resendStatus');
            statusDiv.innerHTML = '<span class="text-muted"><i class="bi bi-arrow-repeat spin"></i> Đang gửi lại mã...</span>';

            fetch('/Auth/ResendOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'email=' + encodeURIComponent(email)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    statusDiv.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> ' + data.message + '</span>';
                    startTimer();
                } else {
                    statusDiv.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle"></i> ' + data.message + '</span>';
                }
            })
            .catch(err => {
                statusDiv.innerHTML = '<span class="text-danger">Không thể gửi lại mã. Vui lòng thử lại sau.</span>';
            });
        });
    </script>
}
