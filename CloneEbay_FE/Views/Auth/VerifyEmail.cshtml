@model CloneEbay_FE.Models.VerifyOtpViewModel
@{
    ViewData["Title"] = "Xác thực Email";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-4">
        <div class="simple-card text-center">
            <!-- Icon -->
            <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-shield-lock fs-3 text-primary"></i>
            </div>

            <h3 class="fw-bold mb-1">Xác thực mã OTP</h3>
            <p class="text-muted small mb-4">
                Mã xác thực đã được gửi tới email:<br />
                <strong class="text-dark">@Model.Email</strong>
            </p>

            <form asp-action="VerifyEmail" method="post" id="verifyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="OtpCode" class="form-label d-block text-start">Nhập mã 6 chữ số</label>
                    <input asp-for="OtpCode" class="form-control text-center fw-bold fs-4" 
                           placeholder="123456" maxlength="6" autofocus style="letter-spacing: 6px;" />
                    <span asp-validation-for="OtpCode" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-main mb-3">
                    Xác nhận kích hoạt
                </button>
            </form>

            <div class="mt-2 text-muted small">
                <span>Chưa nhận được mã?</span>
                <button type="button" id="resendBtn" class="btn btn-link text-primary p-0 small fw-semibold text-decoration-none ms-1">
                    Gửi lại mã (<span id="timerText">60s</span>)
                </button>
                <div id="resendStatus" class="mt-2 small"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let countdown = 60;
        let resendBtn = document.getElementById('resendBtn');
        let timerText = document.getElementById('timerText');
        let timerInterval = null;

        function startTimer() {
            resendBtn.disabled = true;
            countdown = 60;
            timerText.innerText = countdown + 's';
            if (timerInterval) clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                countdown--;
                if (countdown <= 0) {
                    clearInterval(timerInterval);
                    resendBtn.disabled = false;
                    timerText.innerText = 'Gửi lại ngay';
                } else {
                    timerText.innerText = countdown + 's';
                }
            }, 1000);
        }

        startTimer();

        resendBtn.addEventListener('click', function () {
            if (countdown > 0) return;

            let email = document.querySelector('input[name="Email"]').value;
            let statusDiv = document.getElementById('resendStatus');
            statusDiv.innerHTML = '<span class="text-muted"><i class="bi bi-arrow-repeat spin"></i> Đang gửi lại...</span>';

            fetch('/Auth/ResendOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'email=' + encodeURIComponent(email)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    statusDiv.innerHTML = '<span class="text-success">' + data.message + '</span>';
                    startTimer();
                } else {
                    statusDiv.innerHTML = '<span class="text-danger">' + data.message + '</span>';
                }
            })
            .catch(err => {
                statusDiv.innerHTML = '<span class="text-danger">Không thể gửi lại mã. Vui lòng thử lại sau.</span>';
            });
        });
    </script>
}
