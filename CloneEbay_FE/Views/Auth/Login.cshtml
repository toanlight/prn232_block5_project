@model CloneEbay_FE.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-4">
        <div class="simple-card">
            <!-- Header -->
            <div class="text-center mb-4">
                <h3 class="fw-bold mb-1">Đăng nhập</h3>
                <p class="text-muted small mb-0">Chào mừng bạn quay trở lại</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Username or Email -->
                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label">Tài khoản / Email</label>
                    <input asp-for="UsernameOrEmail" class="form-control" placeholder="Nhập username hoặc email" autofocus />
                    <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Remember me -->
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberCheck" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small" for="rememberCheck">
                        Ghi nhớ đăng nhập
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-main mb-3">
                    Đăng nhập
                </button>

                <!-- Footer Link -->
                <div class="text-center text-muted small">
                    Chưa có tài khoản? 
                    <a asp-action="Register" class="text-primary fw-semibold text-decoration-none ms-1">Đăng ký ngay</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
