@model CloneEbay_FE.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-2">Đăng nhập CloneEbay</h2>
                <p class="text-muted">Chào mừng bạn quay trở lại! Vui lòng điền thông tin</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Tên đăng nhập hoặc Email" autofocus />
                    </div>
                    <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Password" class="form-label fw-semibold mb-0"></label>
                        <a href="#" class="small text-primary text-decoration-none">Quên mật khẩu?</a>
                    </div>
                    <div class="input-group mt-1">
                        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small" for="rememberMeCheck">
                        Duy trì trạng thái đăng nhập
                    </label>
                </div>

                <button type="submit" class="btn btn-ebay-primary w-100 py-2 fs-6 mb-3 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                </button>

                <div class="text-center">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a asp-action="Register" class="fw-semibold text-primary text-decoration-none ms-1">Đăng ký ngay</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
