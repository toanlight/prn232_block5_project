@model CloneEbay_FE.Models.AddressViewModel
@{
    ViewData["Title"] = "Thêm địa chỉ giao hàng";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center gap-2 mb-3">
            <i class="bi bi-arrow-left"></i>Quay lại danh sách địa chỉ
        </a>
        <div class="simple-card">
            <div class="mb-4">
                <span class="text-primary fw-bold small">ĐỊA CHỈ MỚI</span>
                <h1 class="h4 fw-bold mt-1 mb-1">Thêm địa chỉ giao hàng</h1>
                <p class="text-muted mb-0">Thông tin này sẽ được dùng để giao đơn hàng cho bạn.</p>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <partial name="_AddressFormFields" model="Model" />
                <div class="d-flex flex-column flex-sm-row gap-2 mt-4 pt-4 border-top">
                    <button type="submit" class="btn-main" style="width: auto; min-width: 190px;">
                        <i class="bi bi-check-lg me-2"></i>Lưu địa chỉ
                    </button>
                    <a asp-action="Index" class="btn btn-light border rounded-3 px-4 py-2">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
