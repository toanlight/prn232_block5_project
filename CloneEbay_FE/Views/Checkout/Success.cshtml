@model CloneEbay_FE.Models.OrderCreatedViewModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="mx-auto" style="max-width: 650px">
    <div class="card border-0 shadow-sm text-center">
        <div class="card-body p-5">
            <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:76px;height:76px">
                <i class="bi bi-check-lg fs-1"></i>
            </div>
            <h1 class="h3">Đặt hàng thành công</h1>
            <p class="text-muted">Mã đơn hàng của bạn là <strong class="text-dark">#@Model.OrderId</strong>.</p>
            <div class="bg-light rounded-3 p-3 my-4 text-start">
                <div class="d-flex justify-content-between mb-2"><span>Phương thức thanh toán</span><strong>@Model.PaymentMethod</strong></div>
                <div class="d-flex justify-content-between"><span>Tổng thanh toán</span><strong class="text-danger">@Model.Total.ToString("N0") ₫</strong></div>
            </div>
            <p class="small text-muted">Giỏ hàng đã được làm trống và số lượng tồn kho đã được cập nhật.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-2"><i class="bi bi-bag"></i> Tiếp tục mua sắm</a>
        </div>
    </div>
</div>
