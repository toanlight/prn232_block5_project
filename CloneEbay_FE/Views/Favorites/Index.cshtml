@model List<CloneEbay_FE.Models.ProductCardViewModel>
@{
    ViewData["Title"] = "Sản phẩm ưa thích";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-heart-fill text-danger me-2"></i>Sản phẩm ưa thích</h1>
        <p class="text-muted mb-0">Danh sách sản phẩm bạn đã lưu.</p>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
</div>

@if (!Model.Any())
{
    <div class="text-center p-5 bg-white rounded-4 shadow-sm">
        <i class="bi bi-heart fs-1 text-muted d-block mb-3"></i>
        <p class="fw-semibold mb-2">Bạn chưa có sản phẩm ưa thích.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Khám phá sản phẩm</a>
    </div>
}
else
{
    <div class="row g-3">
    @foreach (var product in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark">
                    <div class="ratio ratio-1x1 bg-light">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="object-fit-cover w-100 h-100" alt="@product.Title" />
                        }
                    </div>
                    <div class="card-body">
                        <div class="small text-primary">@(product.CategoryName ?? "Chưa phân loại")</div>
                        <div class="fw-semibold text-truncate mt-1">@product.Title</div>
                        <div class="text-danger fw-bold mt-2">@product.Price.ToString("N0") ₫</div>
                    </div>
                </a>
                <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                    <form asp-action="Toggle" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="isFavorite" value="true" />
                        <button class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-heartbreak"></i> Bỏ ưa thích</button>
                    </form>
                </div>
            </div>
        </div>
    }
    </div>
}
