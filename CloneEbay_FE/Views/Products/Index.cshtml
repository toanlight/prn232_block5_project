@model CloneEbay_FE.Models.ProductIndexViewModel
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Khám phá sản phẩm</h1>
        <p class="text-muted mb-0">
            @Model.Results.TotalItems sản phẩm phù hợp
        </p>
    </div>
</div>

@* ── Bộ lọc tìm kiếm ── *@
<form method="get" class="card border-0 shadow-sm rounded-4 p-3 mb-4">
    <div class="row g-2 align-items-end">

        <div class="col-12 col-md-4">
            <label class="form-label fw-semibold small mb-1">Tìm kiếm tên</label>
            <input name="search" value="@Model.Search"
                   class="form-control"
                   placeholder="Nhập tên sản phẩm..." />
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Danh mục</label>
            <select name="categoryId" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var c in Model.Categories)
                {
                    if (c.Id == Model.CategoryId)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Giá từ (₫)</label>
            <input name="minPrice" value="@Model.MinPrice"
                   type="number" min="0" step="1000"
                   class="form-control" placeholder="0" />
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold small mb-1">Giá đến (₫)</label>
            <input name="maxPrice" value="@Model.MaxPrice"
                   type="number" min="0" step="1000"
                   class="form-control" placeholder="Không giới hạn" />
        </div>

        <div class="col-6 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>

    </div>
</form>

@* ── Không có kết quả ── *@
@if (!Model.Results.Items.Any())
{
    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
        <i class="bi bi-search fs-1 text-muted"></i>
        <p class="mt-3 mb-2 fw-semibold">Không tìm thấy sản phẩm phù hợp.</p>
        <p class="text-muted small">Thử thay đổi từ khóa hoặc xóa bộ lọc.</p>
        <a asp-action="Index" class="btn btn-outline-primary mt-2">Xem tất cả sản phẩm</a>
    </div>
}
else
{
    @* ── Lưới sản phẩm ── *@
    <div class="row g-3">
        @foreach (var p in Model.Results.Items)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a asp-action="Details" asp-route-id="@p.Id"
                   class="card h-100 border-0 shadow-sm text-decoration-none text-dark overflow-hidden product-card">

                    @* Ảnh sản phẩm *@
                    <div class="ratio ratio-1x1 bg-light overflow-hidden position-relative">
                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl"
                                 class="object-fit-cover w-100 h-100"
                                 alt="@p.Title"
                                 loading="lazy"
                                 onerror="this.parentElement.querySelector('.no-img').style.display='flex'; this.remove();" />
                        }
                        <div class="no-img d-none align-items-center justify-content-center h-100 bg-light">
                            <i class="bi bi-image text-muted fs-1"></i>
                        </div>
                        @if (p.IsAuction)
                        {
                            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                                <i class="bi bi-hammer"></i> Đấu giá
                            </span>
                        }
                    </div>

                    @* Thông tin sản phẩm *@
                    <div class="card-body p-3">
                        <span class="small text-primary fw-semibold">@(p.CategoryName ?? "Chưa phân loại")</span>
                        <h2 class="h6 mt-1 mb-2 text-truncate" title="@p.Title">@p.Title</h2>

                        <div class="fw-bold text-danger fs-6">@p.Price.ToString("N0") ₫</div>

                        <div class="d-flex align-items-center gap-1 mt-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= (int)Math.Round(p.AverageRating))
                                {
                                    <i class="bi bi-star-fill text-warning" style="font-size:12px"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-muted" style="font-size:12px"></i>
                                }
                            }
                            <span class="small text-muted ms-1">(@p.ReviewCount)</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    @* ── Phân trang ── *@
    @if (Model.Results.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Phân trang">
            <ul class="pagination justify-content-center flex-wrap">

                @* Nút Previous *@
                <li class="page-item @(Model.Results.Page <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-page="@(Model.Results.Page - 1)"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @* Số trang (hiển thị thông minh) *@
                @{
                    int curPage = Model.Results.Page;
                    int totalPages = Model.Results.TotalPages;
                    bool prevEllipsis = false;
                    bool nextEllipsis = false;
                }
                @for (var i = 1; i <= totalPages; i++)
                {
                    bool show = (i == 1 || i == totalPages || (i >= curPage - 2 && i <= curPage + 2));
                    if (!show)
                    {
                        if (i < curPage && !prevEllipsis) { prevEllipsis = true; <li class="page-item disabled"><span class="page-link">…</span></li> }
                        else if (i > curPage && !nextEllipsis) { nextEllipsis = true; <li class="page-item disabled"><span class="page-link">…</span></li> }
                        continue;
                    }
                    <li class="page-item @(i == curPage ? "active" : "")">
                        <a class="page-link"
                           asp-route-page="@i"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice">@i</a>
                    </li>
                }

                @* Nút Next *@
                <li class="page-item @(Model.Results.Page >= Model.Results.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-page="@(Model.Results.Page + 1)"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
        <p class="text-center text-muted small">
            Trang @Model.Results.Page / @Model.Results.TotalPages &bull; Tổng @Model.Results.TotalItems sản phẩm
        </p>
    }
}

<style>
    .product-card { transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .product-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.13) !important; }
</style>
