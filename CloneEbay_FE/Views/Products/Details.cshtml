@model CloneEbay_FE.Models.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Title;
    var loggedIn = Context.Session.GetString("AccessToken") is not null;
}

<div class="mb-3">
    <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted small">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

@* ── Thông tin chính ── *@
<div class="row g-4">

    @* Cột ảnh *@
    <div class="col-12 col-md-6">
        <div class="bg-white rounded-4 shadow-sm overflow-hidden" style="aspect-ratio:1/1">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     class="w-100 h-100 object-fit-cover"
                     alt="@Model.Title"
                     onerror="this.src=''; this.parentElement.innerHTML='<div class=\'d-flex align-items-center justify-content-center h-100 bg-light\'><i class=\'bi bi-image text-muted\' style=\'font-size:4rem\'></i></div>'" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center h-100 bg-light">
                    <i class="bi bi-image text-muted" style="font-size: 4rem"></i>
                </div>
            }
        </div>
    </div>

    @* Cột thông tin *@
    <div class="col-12 col-md-6">

        @* Danh mục & badge *@
        <div class="d-flex gap-2 mb-2">
            <span class="badge text-bg-light border">@(Model.CategoryName ?? "Chưa phân loại")</span>
            @if (Model.IsAuction)
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-hammer"></i> Đấu giá</span>
            }
        </div>

        @* Tên sản phẩm *@
        <h1 class="h2 mb-2">@Model.Title</h1>

        @* Đánh giá tổng quan *@
        <div class="d-flex align-items-center gap-2 mb-3">
            @for (int i = 1; i <= 5; i++)
            {
                <i class="bi @(i <= (int)Math.Round(Model.AverageRating) ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
            }
            <span class="fw-semibold">@Model.AverageRating</span>
            <span class="text-muted">(@Model.ReviewCount đánh giá)</span>
        </div>

        @* Giá *@
        <div class="display-6 fw-bold text-danger mb-3">
            @if (Model.Auction is not null)
            {
                <span id="auctionCurrentPrice">@Model.Auction.CurrentPrice.ToString("N0")</span><span> ₫</span>
                <div class="fs-6 fw-normal text-muted">Giá hiện tại</div>
            }
            else
            {
                <span>@Model.Price.ToString("N0") ₫</span>
            }
        </div>

        @* Mô tả *@
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="mb-3">
                <h5 class="fw-semibold mb-1">Mô tả sản phẩm</h5>
                <p class="text-secondary" style="white-space: pre-line">@Model.Description</p>
            </div>
        }

        @* Thông tin người bán *@
        @if (Model.Seller is not null)
        {
            <div class="border rounded-3 p-3 mb-3 d-flex align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.Seller.AvatarUrl))
                {
                    <img src="@Model.Seller.AvatarUrl"
                         class="rounded-circle"
                         style="width:48px;height:48px;object-fit:cover"
                         alt="@Model.Seller.Name"
                         onerror="this.remove()" />
                }
                else
                {
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
                         style="width:48px;height:48px;min-width:48px">
                        @Model.Seller.Name.FirstOrDefault()
                    </div>
                }
                <div>
                    <div class="text-muted small">Người bán</div>
                    <div class="fw-semibold">@Model.Seller.Name</div>
                </div>
            </div>
        }

        @if (Model.IsAuction)
        {
            @if (Model.Auction is null)
            {
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Chưa thể tải thông tin phiên đấu giá.
                </div>
            }
            else
            {
                var auctionActive = Model.Auction.Status.Equals("Active", StringComparison.OrdinalIgnoreCase);
                var auctionStatusText = Model.Auction.Status.ToLowerInvariant() switch
                {
                    "active" => "Đang diễn ra",
                    "sold" => "Đã bán",
                    "unsold" => "Không có người thắng",
                    _ => "Đã kết thúc"
                };
                <div id="auctionPanel"
                     class="border border-warning rounded-4 p-3 bg-warning bg-opacity-10"
                     data-product-id="@Model.Id"
                     data-end-time="@Model.Auction.EndTime.ToString("O")">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <span class="fw-semibold">
                            <i class="bi bi-hammer me-1"></i>Phiên đấu giá
                        </span>
                        <span id="auctionStatus" class="badge @(auctionActive ? "bg-success" : "bg-secondary")">
                            @auctionStatusText
                        </span>
                    </div>

                    <div class="row g-2 small mb-3">
                        <div class="col-6">
                            <div class="text-muted">Số lượt đặt giá</div>
                            <strong id="auctionBidCount">@Model.Auction.BidCount</strong>
                        </div>
                        <div class="col-6">
                            <div class="text-muted">Bước giá</div>
                            <strong>@Model.Auction.BidIncrement.ToString("N0") ₫</strong>
                        </div>
                        <div class="col-12">
                            <div class="text-muted">Thời gian còn lại</div>
                            <strong id="auctionCountdown">Đang tính...</strong>
                        </div>
                    </div>

                    @if (auctionActive && Model.Auction.IsCurrentUserLeading)
                    {
                        <div class="alert alert-success py-2 small mb-3">
                            <i class="bi bi-trophy-fill me-1"></i>Bạn đang dẫn đầu.
                            @if (Model.Auction.CurrentUserBid.HasValue)
                            {
                                <span>Giá bạn đã đặt: <strong>@Model.Auction.CurrentUserBid.Value.ToString("N0") ₫</strong>.</span>
                            }
                        </div>
                    }
                    else if (!auctionActive && Model.Auction.IsCurrentUserLeading)
                    {
                        <div class="alert alert-success py-2 small mb-3">
                            <i class="bi bi-trophy-fill me-1"></i>Bạn là người thắng phiên đấu giá này.
                        </div>
                    }

                    @if (auctionActive)
                    {
                        @if (loggedIn)
                        {
                            <form asp-controller="Products" asp-action="PlaceBid" method="post" id="placeBidForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <label for="bidAmount" class="form-label fw-semibold">Giá bạn muốn đặt</label>
                                <div class="input-group">
                                    <input id="bidAmount"
                                           name="bidAmount"
                                           type="number"
                                           min="@Model.Auction.MinimumNextBid.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                           max="99949999.99"
                                           step="1000"
                                           value="@Model.Auction.MinimumNextBid.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                           class="form-control"
                                           required />
                                    <span class="input-group-text">₫</span>
                                    <button type="submit" class="btn btn-warning fw-semibold">
                                        <i class="bi bi-hammer me-1"></i>Đặt giá
                                    </button>
                                </div>
                                <div class="form-text">
                                    Tối thiểu <strong id="auctionMinimumBid">@Model.Auction.MinimumNextBid.ToString("N0") ₫</strong>.
                                    Giá đặt sẽ xuất hiện trong lịch sử dưới tên đã được ẩn một phần.
                                </div>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Auth"
                               asp-action="Login"
                               asp-route-returnUrl="/Products/Details/@Model.Id"
                               class="btn btn-warning w-100 fw-semibold">
                                Đăng nhập để đặt giá
                            </a>
                        }
                    }
                    else if (Model.Auction.OrderId.HasValue)
                    {
                        <a asp-controller="Payment"
                           asp-action="PayPal"
                           asp-route-orderId="@Model.Auction.OrderId"
                           class="btn btn-primary w-100 fw-semibold">
                            <i class="bi bi-paypal me-1"></i>Thanh toán đơn thắng đấu giá
                        </a>
                    }
                </div>
            }
        }
        else if (loggedIn)
        {
            @* Đã đăng nhập → thêm thẳng vào giỏ server *@
            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="title" value="@Model.Title" />
                <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
                <input type="hidden" name="unitPrice" value="@Model.Price" />
                <input type="hidden" name="returnProductId" value="@Model.Id" />

                <div class="input-group" style="max-width: 130px">
                    <button type="button" class="btn btn-outline-secondary" id="btnMinus">
                        <i class="bi bi-dash"></i>
                    </button>
                    <input id="qtyInput" name="quantity" value="1" min="1" max="99"
                           type="number" class="form-control text-center" />
                    <button type="button" class="btn btn-outline-secondary" id="btnPlus">
                        <i class="bi bi-plus"></i>
                    </button>
                </div>

                <button class="btn btn-primary flex-grow-1 py-2">
                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                </button>
            </form>
        }
        else
        {
            @* Chưa đăng nhập → lưu vào localStorage *@
            <button id="addLocalCart" class="btn btn-primary w-100 py-2"
                    data-product-id="@Model.Id"
                    data-title="@Model.Title"
                    data-price="@Model.Price"
                    data-image="@Model.ImageUrl">
                <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
            </button>
            <div class="small text-muted mt-2">
                <i class="bi bi-info-circle"></i>
                Sản phẩm sẽ lưu trên trình duyệt.
                <a asp-controller="Auth" asp-action="Login"
                   asp-route-returnUrl="/Products/@Model.Id">Đăng nhập</a>
                để đồng bộ giỏ hàng.
            </div>
        }

        <div class="mt-2">
            @if (loggedIn)
            {
                <form asp-controller="Favorites" asp-action="Toggle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnProductId" value="@Model.Id" />
                    <input type="hidden" name="isFavorite" value="@(ViewBag.IsFavorite == true ? "true" : "false")" />
                    @if (ViewBag.IsFavorite == true)
                    {
                        <button class="btn btn-outline-danger w-100 py-2"><i class="bi bi-heart-fill"></i> Bỏ khỏi mục ưa thích</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-danger w-100 py-2"><i class="bi bi-heart"></i> Thêm vào mục ưa thích</button>
                    }
                </form>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="/Products/Details/@Model.Id" class="btn btn-outline-danger w-100 py-2">
                    <i class="bi bi-heart"></i> Đăng nhập để thêm vào mục ưa thích
                </a>
            }
        </div>

    </div>
</div>

@if (Model.Auction?.RecentBids.Any() == true)
{
    <section class="mt-4">
        <div class="bg-white rounded-4 shadow-sm p-4">
            <h2 class="h5 mb-3"><i class="bi bi-clock-history me-2"></i>Lịch sử đặt giá gần đây</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Người đặt</th>
                            <th>Giá đặt</th>
                            <th class="text-end">Thời gian</th>
                        </tr>
                    </thead>
                    <tbody id="auctionBidHistory">
                        @foreach (var bid in Model.Auction.RecentBids)
                        {
                            <tr class="@(bid.IsCurrentUser ? "table-success" : null)">
                                <td>@bid.Bidder</td>
                                <td class="fw-semibold">@bid.Amount.ToString("N0") ₫</td>
                                <td class="text-end text-muted">@bid.BidTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}

@* ── Phần đánh giá ── *@
<section class="mt-5">
    <h2 class="h4 mb-3">
        <i class="bi bi-chat-square-text"></i>
        Đánh giá sản phẩm
        <span class="badge bg-secondary ms-1">@Model.ReviewCount</span>
    </h2>

    @if (!Model.Reviews.Any())
    {
        <div class="bg-white rounded-3 shadow-sm p-4 text-center text-muted">
            <i class="bi bi-emoji-smile fs-2 d-block mb-2"></i>
            Sản phẩm chưa có đánh giá nào.
        </div>
    }
    else
    {
        @foreach (var review in Model.Reviews)
        {
            <div class="bg-white rounded-3 shadow-sm p-3 mb-2">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center fw-bold"
                             style="width:36px;height:36px;min-width:36px;font-size:14px">
                            @review.ReviewerName.FirstOrDefault()
                        </div>
                        <div>
                            <div class="fw-semibold">@review.ReviewerName</div>
                            @if (review.CreatedAt.HasValue)
                            {
                                <div class="text-muted small">@review.CreatedAt.Value.ToString("dd/MM/yyyy")</div>
                            }
                        </div>
                    </div>
                    <div class="text-warning">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(review.Comment))
                {
                    <p class="mb-0 mt-2 text-secondary">@review.Comment</p>
                }
            </div>
        }
    }
</section>

@section Scripts {
<script>
    // Tăng/giảm số lượng
    const qty = document.getElementById('qtyInput');
    document.getElementById('btnMinus')?.addEventListener('click', () => {
        if (qty && +qty.value > 1) qty.value = +qty.value - 1;
    });
    document.getElementById('btnPlus')?.addEventListener('click', () => {
        if (qty && +qty.value < 99) qty.value = +qty.value + 1;
    });

    // Thêm vào giỏ local (chưa đăng nhập)
    document.getElementById('addLocalCart')?.addEventListener('click', e => {
        const b = e.currentTarget;
        const key = 'cloneEbay.localCart';
        const cart = JSON.parse(localStorage.getItem(key) || '[]');
        const id = +b.dataset.productId;
        const existing = cart.find(x => x.productId === id);
        if (existing) {
            existing.quantity = Math.min(existing.quantity + 1, 99);
        } else {
            cart.push({
                productId: id,
                quantity: 1,
                title: b.dataset.title,
                unitPrice: +b.dataset.price,
                imageUrl: b.dataset.image || null
            });
        }
        localStorage.setItem(key, JSON.stringify(cart));

        // Hiển thị thông báo nhỏ
        b.innerHTML = '<i class="bi bi-check-circle"></i> Đã thêm vào giỏ!';
        b.classList.replace('btn-primary', 'btn-success');
        setTimeout(() => {
            b.innerHTML = '<i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng';
            b.classList.replace('btn-success', 'btn-primary');
        }, 1500);
    });

    // Đồng hồ đếm ngược và cập nhật giá đấu theo thời gian thực.
    const auctionPanel = document.getElementById('auctionPanel');
    if (auctionPanel) {
        const productId = Number(auctionPanel.dataset.productId);
        const endTime = new Date(auctionPanel.dataset.endTime);
        const countdown = document.getElementById('auctionCountdown');
        const money = value => new Intl.NumberFormat('vi-VN').format(value) + ' ₫';

        const updateCountdown = () => {
            const remaining = endTime.getTime() - Date.now();
            if (remaining <= 0) {
                countdown.textContent = 'Đã kết thúc';
                document.querySelector('#placeBidForm button[type="submit"]')?.setAttribute('disabled', 'disabled');
                return;
            }

            const totalSeconds = Math.floor(remaining / 1000);
            const days = Math.floor(totalSeconds / 86400);
            const hours = Math.floor((totalSeconds % 86400) / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;
            countdown.textContent = `${days > 0 ? days + ' ngày ' : ''}${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        };

        updateCountdown();
        setInterval(updateCountdown, 1000);

        if (typeof signalR !== 'undefined') {
            const auctionConnection = new signalR.HubConnectionBuilder()
                .withUrl('http://localhost:5180/hubs/auction')
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .build();

            const joinAuction = () => auctionConnection.invoke('JoinAuction', productId);

            auctionConnection.on('AuctionUpdated', data => {
                if (Number(data.productId) !== productId) return;
                document.getElementById('auctionCurrentPrice').textContent = new Intl.NumberFormat('vi-VN').format(data.currentPrice);
                document.getElementById('auctionBidCount').textContent = data.bidCount;
                document.getElementById('auctionMinimumBid').textContent = money(data.minimumNextBid);
                const input = document.getElementById('bidAmount');
                if (input) {
                    input.min = data.minimumNextBid;
                    if (Number(input.value) < Number(data.minimumNextBid)) input.value = data.minimumNextBid;
                }
            });

            auctionConnection.on('AuctionEnded', data => {
                if (Number(data.productId) !== productId) return;
                document.getElementById('auctionStatus').textContent = data.type === 'SOLD' ? 'Đã bán' : 'Đã kết thúc';
                countdown.textContent = 'Đã kết thúc';
                document.querySelector('#placeBidForm button[type="submit"]')?.setAttribute('disabled', 'disabled');
            });

            auctionConnection.onreconnected(joinAuction);
            auctionConnection.start().then(joinAuction).catch(error => console.warn('Không thể kết nối AuctionHub:', error));
        }
    }
</script>
}
