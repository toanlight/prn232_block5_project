@model List<CloneEbay_FE.Models.NotificationViewModel>
@{
    ViewData["Title"] = "Lịch sử thông báo hệ thống";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-bell-fill text-primary me-2"></i>Lịch Sử Thông Báo Hệ Thống
            </h3>
            <p class="text-muted small mb-0">Các tin nhắn thông báo real-time và cập nhật đơn hàng, hoàn trả, khuyến mãi.</p>
        </div>
        @if (Model != null && Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                    <i class="bi bi-check2-all me-1"></i> Đánh dấu tất cả là đã đọc
                </button>
            </form>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-bell-slash text-muted display-4 mb-3 d-block"></i>
                <h6 class="fw-bold text-dark mb-1">Chưa có thông báo nào</h6>
                <p class="text-muted small mb-0">Các thông báo mới về đơn hàng và chương trình khuyến mãi sẽ tự động xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model)
                {
                    var iconClass = item.Type switch
                    {
                        "Order" => "bi-box-seam-fill text-success",
                        "Return" => "bi-arrow-return-left text-danger",
                        "Promotion" => "bi-ticket-perforated-fill text-warning",
                        "Feedback" => "bi-star-fill text-warning",
                        _ => "bi-bell-fill text-primary"
                    };

                    var badgeBg = item.Type switch
                    {
                        "Order" => "bg-success text-white",
                        "Return" => "bg-danger text-white",
                        "Promotion" => "bg-warning text-dark",
                        "Feedback" => "bg-warning text-dark",
                        _ => "bg-primary text-white"
                    };

                    <div class="p-3 rounded-3 border d-flex align-items-start gap-3 @(item.IsRead ? "bg-light opacity-75" : "bg-white border-start border-4 border-primary shadow-sm")" id="notif-item-@item.Id">
                        <div class="p-2 bg-white rounded-circle border shadow-sm flex-shrink-0">
                            <i class="bi @iconClass fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @badgeBg px-2 py-1 fs-7">@item.Type</span>
                                    <h6 class="fw-bold text-dark mb-0 fs-6">@item.Title</h6>
                                </div>
                                <span class="text-muted fs-7">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <p class="text-secondary mb-2 small" style="white-space: pre-line;">@item.Content</p>
                            
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.LinkUrl))
                                {
                                    <a href="@item.LinkUrl" class="btn btn-xs btn-outline-primary rounded-pill px-3 fs-7 text-decoration-none" onclick="markRead(@item.Id)">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> Xem chi tiết
                                    </a>
                                }
                                @if (!item.IsRead)
                                {
                                    <button type="button" class="btn btn-xs btn-link text-muted text-decoration-none fs-7 p-0" onclick="markRead(@item.Id)">
                                        <i class="bi bi-check me-1"></i>Đánh dấu đã đọc
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function markRead(id) {
            fetch('/Notification/MarkAsRead?id=' + id, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        const el = document.getElementById('notif-item-' + id);
                        if (el) {
                            el.classList.remove('bg-white', 'border-start', 'border-4', 'border-primary', 'shadow-sm');
                            el.classList.add('bg-light', 'opacity-75');
                        }
                    }
                });
        }
    </script>
}
