@model CloneEbay_FE.Models.CreateReviewViewModel
@{
    ViewData["Title"] = "Viết đánh giá sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="simple-card">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-star-half text-warning me-2"></i>Đánh giá sản phẩm
                </h4>
                <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-sm btn-outline-secondary rounded-2">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="ProductId" />

                <div class="mb-4 text-center p-3 bg-light rounded-3 border">
                    <label class="form-label d-block text-dark fw-bold mb-2">Chọn mức độ hài lòng của bạn</label>
                    <input type="hidden" asp-for="Rating" id="ratingInput" value="5" />

                    <!-- Interactive Star Rating UI -->
                    <div class="star-rating d-flex justify-content-center gap-2 fs-2 text-warning cursor-pointer" id="starContainer">
                        <i class="bi bi-star-fill star-item" data-rating="1"></i>
                        <i class="bi bi-star-fill star-item" data-rating="2"></i>
                        <i class="bi bi-star-fill star-item" data-rating="3"></i>
                        <i class="bi bi-star-fill star-item" data-rating="4"></i>
                        <i class="bi bi-star-fill star-item" data-rating="5"></i>
                    </div>
                    <span id="ratingText" class="fw-bold text-primary fs-6 mt-2 d-block">5 / 5 sao (Rất tuyệt vời)</span>
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Comment" class="form-label">Nội dung bình luận / nhận xét sản phẩm</label>
                    <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Nhập cảm nhận của bạn về chất lượng sản phẩm, tốc độ giao hàng..."></textarea>
                    <span asp-validation-for="Comment" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-main">
                    <i class="bi bi-send-check me-1"></i> Gửi đánh giá ngay
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const stars = document.querySelectorAll('.star-item');
            const ratingInput = document.getElementById('ratingInput');
            const ratingText = document.getElementById('ratingText');

            const ratingLabels = {
                1: '1 / 5 sao (Tệ)',
                2: '2 / 5 sao (Tạm được)',
                3: '3 / 5 sao (Bình thường)',
                4: '4 / 5 sao (Hài lòng)',
                5: '5 / 5 sao (Rất tuyệt vời)'
            };

            function updateStars(value) {
                ratingInput.value = value;
                ratingText.textContent = ratingLabels[value] || (value + ' sao');

                stars.forEach((star, index) => {
                    if (index < value) {
                        star.classList.remove('bi-star', 'text-muted', 'opacity-50');
                        star.classList.add('bi-star-fill', 'text-warning');
                    } else {
                        star.classList.remove('bi-star-fill', 'text-warning');
                        star.classList.add('bi-star', 'text-muted', 'opacity-50');
                    }
                });
            }

            stars.forEach(star => {
                star.addEventListener('click', function () {
                    const rating = parseInt(this.getAttribute('data-rating'));
                    updateStars(rating);
                });

                star.style.cursor = 'pointer';
            });

            updateStars(parseInt(ratingInput.value) || 5);
        });
    </script>
}
