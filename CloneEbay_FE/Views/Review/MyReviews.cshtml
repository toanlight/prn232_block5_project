@model List<CloneEbay_FE.Models.ReviewViewModel>
@{
    ViewData["Title"] = "Đánh giá của tôi";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-heart text-primary me-2"></i>Đánh giá của tôi
        </h3>
        <p class="text-muted small mb-0">Các đánh giá bạn đã viết cho các sản phẩm đã mua.</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="simple-card text-center py-5">
        <i class="bi bi-chat-left-dots text-muted display-4 mb-3 d-block"></i>
        <h5 class="fw-bold text-dark mb-1">Bạn chưa viết đánh giá nào</h5>
        <p class="text-muted small mb-0">Sau khi nhận hàng thành công, hãy viết đánh giá để chia sẻ cảm nhận với mọi người nhé.</p>
    </div>
}
else
{
    <div class="simple-card p-4">
        <div class="d-flex flex-column gap-3">
            @foreach (var r in Model)
            {
                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <span class="fw-bold text-dark fs-6">Sản phẩm: @r.ProductTitle</span>
                            <span class="text-muted fs-7 d-block">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="text-warning">
                            @for (int s = 1; s <= 5; s++)
                            {
                                if (s <= r.Rating)
                                {
                                    <i class="bi bi-star-fill fs-6"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star fs-6 text-muted opacity-50"></i>
                                }
                            }
                        </div>
                    </div>

                    <p class="text-dark small mb-0 mt-2">@r.Comment</p>
                </div>
            }
        </div>
    </div>
}
