@model CloneEbay_FE.Models.ProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="row">
    <!-- Sidebar / User summary -->
    <div class="col-md-4 mb-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <div class="mb-3 position-relative d-inline-block mx-auto">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Avatar">
                }
                else
                {
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto fs-1 fw-bold" style="width: 120px; height: 120px;">
                        @(string.IsNullOrEmpty(Model.FullName) ? Model.Username.Substring(0, 1).ToUpper() : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                }
            </div>

            <h4 class="fw-bold mb-1">@(string.IsNullOrEmpty(Model.FullName) ? Model.Username : Model.FullName)</h4>
            <p class="text-muted small mb-2">@@@Model.Username</p>

            <div class="mb-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                    <i class="bi bi-shield-check"></i> Vai trò: @Model.Role
                </span>
                @if (Model.IsEmailVerified)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 ms-1">
                        <i class="bi bi-check-circle"></i> Đã xác thực Email
                    </span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1 ms-1">
                        <i class="bi bi-exclamation-circle"></i> Chưa kích hoạt
                    </span>
                }
            </div>

            <hr class="text-muted opacity-25">

            <div class="text-start small text-muted">
                <p class="mb-2"><i class="bi bi-envelope me-2 text-primary"></i> <strong>Email:</strong> @Model.Email</p>
                <p class="mb-2"><i class="bi bi-telephone me-2 text-primary"></i> <strong>SĐT:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</p>
                <p class="mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i> <strong>Ngày tham gia:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
    </div>

    <!-- Main Profile Edit & Change Password Tabs -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <ul class="nav nav-pills mb-4" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4" id="edit-tab" data-bs-toggle="pill" data-bs-target="#edit-pane" type="button" role="tab">
                        <i class="bi bi-person-lines-fill me-1"></i> Cập nhật thông tin
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4" id="password-tab" data-bs-toggle="pill" data-bs-target="#password-pane" type="button" role="tab">
                        <i class="bi bi-key-fill me-1"></i> Đổi mật khẩu
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="profileTabsContent">
                <!-- Tab 1: Edit Profile (SCRUM-7 Sub-task 2.3) -->
                <div class="tab-pane fade show active" id="edit-pane" role="tabpanel">
                    <h5 class="fw-bold mb-3">Chỉnh sửa hồ sơ</h5>
                    <form asp-action="Update" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Username" />
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AvatarUrl" class="form-label fw-semibold"></label>
                            <input asp-for="AvatarUrl" class="form-control" placeholder="https://example.com/avatar.jpg" />
                            <div class="form-text">Dán đường dẫn ảnh đại diện (URL) của bạn.</div>
                        </div>

                        <button type="submit" class="btn btn-ebay-primary px-4 py-2">
                            <i class="bi bi-floppy me-1"></i> Lưu thay đổi
                        </button>
                    </form>
                </div>

                <!-- Tab 2: Change Password -->
                <div class="tab-pane fade" id="password-pane" role="tabpanel">
                    <h5 class="fw-bold mb-3">Đổi mật khẩu tài khoản</h5>
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mật khẩu hiện tại</label>
                            <input name="CurrentPassword" type="password" class="form-control" required placeholder="••••••••" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mật khẩu mới</label>
                            <input name="NewPassword" type="password" class="form-control" required minlength="6" placeholder="••••••••" />
                            <div class="form-text">Mật khẩu mới phải có ít nhất 6 ký tự.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                            <input name="ConfirmNewPassword" type="password" class="form-control" required placeholder="••••••••" />
                        </div>

                        <button type="submit" class="btn btn-ebay-primary px-4 py-2">
                            <i class="bi bi-shield-lock me-1"></i> Cập nhật mật khẩu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
