@model CloneEbay_FE.Models.ProfileViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="simple-card">
            <!-- User summary header -->
            <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img id="headerAvatar" src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle border shadow-sm" style="width: 58px; height: 58px; object-fit: cover; flex-shrink: 0;" />
                }
                else
                {
                    <div id="headerAvatarFallback" class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 58px; height: 58px; flex-shrink: 0;">
                        @(string.IsNullOrEmpty(Model.FullName) ? Model.Username.Substring(0, 1).ToUpper() : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                }
                <div>
                    <h4 class="fw-bold mb-0">@(string.IsNullOrEmpty(Model.FullName) ? Model.Username : Model.FullName)</h4>
                    <span class="text-muted small">@@@Model.Username &bull; @Model.Email</span>
                </div>
                <div class="ms-auto">
                    @if (Model.IsEmailVerified)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                            <i class="bi bi-check-circle"></i> Đã xác thực Email
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                            <i class="bi bi-exclamation-circle"></i> Chưa kích hoạt
                        </span>
                    }
                </div>
            </div>

            <!-- Tab Buttons -->
            <ul class="nav nav-pills mb-4 flex-wrap gap-2" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="btn btn-outline-main active py-2 px-3" id="edit-tab" data-bs-toggle="pill" data-bs-target="#edit-pane" type="button" role="tab">
                        <i class="bi bi-person me-1"></i> Thông tin cá nhân
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="btn btn-outline-main py-2 px-3" id="password-tab" data-bs-toggle="pill" data-bs-target="#password-pane" type="button" role="tab">
                        <i class="bi bi-key me-1"></i> Đổi mật khẩu
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="btn btn-outline-main py-2 px-3" asp-controller="Profile" asp-action="Orders">
                        <i class="bi bi-box-seam me-1 text-primary"></i> Đơn mua của tôi
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="btn btn-outline-main py-2 px-3" asp-controller="Address" asp-action="Index">
                        <i class="bi bi-geo-alt me-1 text-primary"></i> Địa chỉ giao hàng
                    </a>
                </li>
            </ul>

            <div class="tab-content" id="profileTabsContent">
                <!-- Tab 1: Update Profile -->
                <div class="tab-pane fade show active" id="edit-pane" role="tabpanel">
                    <form asp-action="Update" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Username" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="AvatarUrl" id="currentAvatarUrl" />

                        <!-- Avatar Upload Box with Live Preview -->
                        <div class="mb-4 p-3 bg-light rounded-3 border">
                            <label class="form-label fw-bold d-block mb-2">Ảnh đại diện</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="position-relative">
                                    <img id="avatarPreviewImg" 
                                         src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.FullName ?? Model.Username) + "&background=2563eb&color=fff&size=128")" 
                                         alt="Avatar Preview" 
                                         class="rounded-circle border shadow-sm" 
                                         style="width: 80px; height: 80px; object-fit: cover;" />
                                </div>
                                <div class="flex-grow-1">
                                    <label for="AvatarFile" class="btn btn-sm btn-outline-primary mb-1">
                                        <i class="bi bi-upload me-1"></i> Chọn ảnh từ máy tính
                                    </label>
                                    <input asp-for="AvatarFile" type="file" class="d-none" id="AvatarFile" accept="image/png, image/jpeg, image/jpg, image/webp, image/gif" />
                                    <div class="text-muted small" id="selectedFileName">Hỗ trợ JPG, PNG, WEBP hoặc GIF (tối đa 5MB)</div>
                                </div>
                            </div>
                            <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên của bạn" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" placeholder="0912345678" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn-main" style="max-width: 200px;">
                            <i class="bi bi-check2-circle me-1"></i> Lưu thông tin
                        </button>
                    </form>
                </div>

                <!-- Tab 2: Change Password -->
                <div class="tab-pane fade" id="password-pane" role="tabpanel">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu hiện tại</label>
                            <input name="CurrentPassword" type="password" class="form-control" required placeholder="••••••••" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <input name="NewPassword" type="password" class="form-control" required minlength="6" placeholder="Tối thiểu 6 ký tự" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Xác nhận mật khẩu mới</label>
                            <input name="ConfirmNewPassword" type="password" class="form-control" required placeholder="••••••••" />
                        </div>

                        <button type="submit" class="btn-main" style="max-width: 200px;">
                            <i class="bi bi-key me-1"></i> Cập nhật mật khẩu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live image preview khi chọn file từ máy tính
        document.getElementById('AvatarFile')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                document.getElementById('selectedFileName').innerText = "Đã chọn: " + file.name;
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById('avatarPreviewImg').src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
