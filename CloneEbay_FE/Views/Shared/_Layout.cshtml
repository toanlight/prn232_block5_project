@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? username;
    var avatarUrl = HttpContextAccessor.HttpContext?.Session.GetString("AvatarUrl");
    var accessToken = HttpContextAccessor.HttpContext?.Session.GetString("AccessToken") ?? HttpContextAccessor.HttpContext?.Request.Cookies["AccessToken"];
    var isLoggedIn = !string.IsNullOrEmpty(username);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CloneEbay</title>
    <!-- Google Fonts & Bootstrap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- SignalR JS Client CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --bg-page: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        /* Top Navbar */
        .app-header {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-text {
            font-size: 24px;
            font-weight: 800;
            text-decoration: none;
            color: #0f172a;
            letter-spacing: -0.5px;
        }
        .brand-text .dot { color: var(--primary); }

        .nav-link-custom {
            color: var(--text-muted);
            font-weight: 500;
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 8px;
            transition: all 0.15s ease;
        }
        .nav-link-custom:hover {
            color: var(--primary);
            background-color: #f1f5f9;
        }

        /* Main Container */
        .main-container {
            flex: 1;
            padding-top: 30px;
            padding-bottom: 50px;
        }

        /* Form Card */
        .simple-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            padding: 32px;
        }

        .form-label {
            font-weight: 600;
            font-size: 14px;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            border: 1.5px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14.5px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .btn-main {
            background-color: var(--primary);
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
            padding: 11px 20px;
            border-radius: 8px;
            border: none;
            transition: background-color 0.15s ease;
            width: 100%;
        }
        .btn-main:hover {
            background-color: var(--primary-hover);
            color: #ffffff;
        }

        .btn-outline-main {
            border: 1.5px solid var(--border-color);
            background: #ffffff;
            color: var(--text-main);
            font-weight: 600;
            padding: 9px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s ease;
        }
        .btn-outline-main:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: #f8fafc;
        }

        /* Footer */
        .app-footer {
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            padding: 20px 0;
            font-size: 13.5px;
            color: var(--text-muted);
            text-align: center;
        }

        .fs-7 { font-size: 12px; }
        .cursor-pointer { cursor: pointer; }
    </style>
</head>
<body>
    <!-- Header Navigation -->
    <header class="app-header py-2">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand-text d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bag-check-fill text-primary me-1 fs-4"></i> CloneEbay<span class="dot">.</span>
            </a>

            <!-- Navigation Links -->
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Products" asp-action="Index" class="nav-link-custom">Sản phẩm</a>
                <a asp-controller="Cart" asp-action="Index" class="nav-link-custom"><i class="bi bi-cart3"></i> Giỏ hàng</a>

                @if (isLoggedIn)
                {
                    <!-- User Account Dropdown (My eBay Style) -->
                    <div class="dropdown me-1">
                        <button class="btn btn-sm btn-outline-light text-dark border-0 d-flex align-items-center gap-2 px-2 py-1 rounded-pill hover-bg-light" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Avatar" class="rounded-circle border shadow-sm" style="width: 30px; height: 30px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 30px; height: 30px; font-size: 13px;">
                                    @(string.IsNullOrEmpty(fullName) ? username?.Substring(0, 1).ToUpper() : fullName.Substring(0, 1).ToUpper())
                                </div>
                            }
                            <span class="fw-semibold small d-none d-sm-inline">@fullName</span>
                            <i class="bi bi-chevron-down fs-7 text-muted"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" aria-labelledby="userMenuDropdown" style="min-width: 200px;">
                            <li>
                                <div class="px-3 py-2 border-bottom mb-1">
                                    <div class="fw-bold text-dark text-truncate">@fullName</div>
                                    <div class="text-muted fs-7 text-truncate">@@@username</div>
                                </div>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Orders">
                                    <i class="bi bi-box-seam text-primary"></i>
                                    <span>Đơn mua của tôi</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2" asp-controller="ReturnRequest" asp-action="Index">
                                    <i class="bi bi-arrow-return-left text-primary"></i>
                                    <span>Yêu cầu hoàn trả</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-gear text-primary"></i>
                                    <span>Tài khoản & Hồ sơ</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 px-3 d-flex align-items-center gap-2 text-danger fw-semibold" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Đăng xuất</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Bell Notification Icon with Badge (Placed to the RIGHT of Avatar) -->
                    <a asp-controller="Notification" asp-action="Index" class="nav-link-custom position-relative p-2 rounded-circle hover-bg-light" title="Thông báo hệ thống">
                        <i class="bi bi-bell fs-5 text-primary"></i>
                        <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger fs-7 d-none">0</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="nav-link-custom">
                        Đăng nhập
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-sm btn-primary rounded-3 px-3 py-2 fw-semibold">
                        Đăng ký tài khoản
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Real-time SignalR Toast Notification Popup Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="liveNotifToast" class="toast align-items-center text-white bg-primary border-0 shadow-lg rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 fs-6">
                    <i class="bi bi-bell-fill fs-5" id="toastIcon"></i>
                    <div id="toastMessage">Thông báo mới từ hệ thống!</div>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Main Body Container -->
    <main class="main-container">
        <div class="container">
            <!-- Alert Messages -->
            @if (!string.IsNullOrWhiteSpace(TempData["SuccessMessage"]?.ToString()))
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"]?.ToString()))
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2 fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(TempData["WarningMessage"]?.ToString()))
            {
                <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle-fill me-2 fs-5 text-warning"></i>
                    <div>@TempData["WarningMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container">
            <span>&copy; 2026 CloneEbay E-Commerce &bull; Hệ thống mua bán & đấu giá trực tuyến</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- SignalR Real-time Connection Script -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {

        // =====================================================
        // 1. GET ACCESS TOKEN
        // =====================================================

        const userAccessToken = "@accessToken";

        // Không có token thì không kết nối SignalR
        if (!userAccessToken || userAccessToken.trim() === '') {
            console.log("SignalR: User chưa đăng nhập hoặc không có access token.");
            return;
        }

        // Kiểm tra SignalR library
        if (typeof signalR === 'undefined') {
            console.error("SignalR library chưa được load.");
            return;
        }


        // =====================================================
        // 2. CREATE SIGNALR CONNECTION
        // =====================================================

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("http://localhost:5180/hubs/notification", {
                accessTokenFactory: function () {
                    return userAccessToken;
                }
            })
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .configureLogging(signalR.LogLevel.Information)
            .build();


        // =====================================================
        // 3. HANDLE INCOMING NOTIFICATION
        // =====================================================

        function handleIncomingNotification(
            data,
            type,
            iconClass,
            toastBg
        ) {

            console.log(
                "Nhận notification:",
                type,
                data
            );


            // =================================================
            // 3.1 SHOW TOAST
            // =================================================

            const toastEl =
                document.getElementById('liveNotifToast');

            const toastMsg =
                document.getElementById('toastMessage');

            const toastIcon =
                document.getElementById('toastIcon');


            if (toastMsg && toastEl) {

                // Set message
                toastMsg.textContent =
                    data?.message ||
                    'Thông báo mới!';


                // Set icon
                if (toastIcon) {

                    toastIcon.className =
                        'bi ' +
                        iconClass +
                        ' fs-5';

                }


                // Reset class của Toast
                toastEl.className =
                    'toast align-items-center text-white border-0 shadow-lg ' +
                    toastBg;


                // Create Bootstrap Toast
                const bsToast =
                    bootstrap.Toast.getOrCreateInstance(
                        toastEl,
                        {
                            delay: 5000
                        }
                    );


                // Show Toast
                bsToast.show();
            }


            // =================================================
            // 3.2 UPDATE NOTIFICATION BADGE
            // =================================================

            const badge =
                document.getElementById('notifBadge');


            if (badge) {

                let currentCount =
                    parseInt(
                        badge.textContent
                    ) || 0;


                currentCount++;


                badge.textContent =
                    currentCount;


                // Hiện badge nếu đang bị ẩn
                badge.classList.remove(
                    'd-none'
                );
            }


            // =================================================
            // 3.3 SAVE NOTIFICATION HISTORY
            // =================================================

            try {

                const storageKey =
                    'cloneEbay_notifications';


                let history =
                    JSON.parse(
                        localStorage.getItem(
                            storageKey
                        ) || '[]'
                    );


                // Nếu dữ liệu LocalStorage bị lỗi
                if (!Array.isArray(history)) {
                    history = [];
                }


                // Tạo notification mới
                const notification = {

                    id:
                        data?.id ||
                        Date.now(),

                    type:
                        type,

                    message:
                        data?.message || '',

                    time:
                        new Date()
                            .toLocaleTimeString(
                                'vi-VN',
                                {
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }
                            ),

                    createdAt:
                        new Date().toISOString(),

                    isRead:
                        false
                };


                // Thêm notification mới vào đầu
                history.unshift(
                    notification
                );


                // =================================================
                // 3.4 LIMIT NOTIFICATIONS
                // =================================================

                const MAX_NOTIFICATIONS = 100;


                if (
                    history.length >
                    MAX_NOTIFICATIONS
                ) {

                    history =
                        history.slice(
                            0,
                            MAX_NOTIFICATIONS
                        );

                }


                // Save lại LocalStorage
                localStorage.setItem(
                    storageKey,
                    JSON.stringify(history)
                );


                console.log(
                    "Notification saved.",
                    notification
                );

            }
            catch (error) {

                console.error(
                    "Lỗi khi lưu notification vào LocalStorage:",
                    error
                );

            }
        }


        // =====================================================
        // 4. ORDER NOTIFICATION
        // =====================================================

        connection.on(
            "ReceiveOrderNotification",
            function (data) {

                console.log(
                    "ReceiveOrderNotification:",
                    data
                );


                handleIncomingNotification(
                    data,
                    "Order",
                    "bi-box-seam-fill",
                    "bg-success"
                );

            }
        );


        // =====================================================
        // 5. PROMOTION NOTIFICATION
        // =====================================================

        connection.on(
            "ReceivePromotionNotification",
            function (data) {

                console.log(
                    "ReceivePromotionNotification:",
                    data
                );


                handleIncomingNotification(
                    data,
                    "Promotion",
                    "bi-ticket-perforated-fill",
                    "bg-warning"
                );

            }
        );


        // =====================================================
        // 6. FEEDBACK NOTIFICATION
        // =====================================================

        connection.on(
            "ReceiveFeedbackNotification",
            function (data) {

                console.log(
                    "ReceiveFeedbackNotification:",
                    data
                );


                handleIncomingNotification(
                    data,
                    "Feedback",
                    "bi-chat-heart-fill",
                    "bg-primary"
                );

            }
        );

        connection.on(
            "ReceiveAuctionNotification",
            function (data) {
                console.log("ReceiveAuctionNotification:", data);
                handleIncomingNotification(
                    data,
                    "Auction",
                    "bi-hammer",
                    data?.type === "AUCTION_WON" ? "bg-success" : "bg-warning"
                );
            }
        );


        // =====================================================
        // 7. SIGNALR RECONNECTING
        // =====================================================

        connection.onreconnecting(
            function (error) {

                console.warn(
                    "⚠ SignalR đang reconnect...",
                    error
                );

            }
        );


        // =====================================================
        // 8. SIGNALR RECONNECTED
        // =====================================================

        connection.onreconnected(
            function (connectionId) {

                console.log(
                    "✅ SignalR đã reconnect."
                );

                console.log(
                    "Connection ID:",
                    connectionId
                );

            }
        );


        // =====================================================
        // 9. SIGNALR CLOSED
        // =====================================================

        connection.onclose(
            function (error) {

                console.warn(
                    "❌ SignalR connection đã đóng.",
                    error
                );

            }
        );


        // =====================================================
        // 10. START CONNECTION
        // =====================================================

        async function startSignalR() {

            // Tránh start nhiều lần
            if (
                connection.state !==
                signalR.HubConnectionState.Disconnected
            ) {

                console.log(
                    "SignalR đang chạy hoặc đang kết nối."
                );

                return;
            }


            try {

                console.log(
                    "Đang kết nối SignalR..."
                );


                await connection.start();


                console.log(
                    "=========================================="
                );

                console.log(
                    "✅ SignalR NotificationHub connected!"
                );

                console.log(
                    "Connection ID:",
                    connection.connectionId
                );

                console.log(
                    "=========================================="
                );

            }
            catch (error) {

                console.error(
                    "❌ SignalR Connection Error:",
                    error
                );

            }

        }


        // Start SignalR
        startSignalR();


        // =====================================================
        // 11. CLEANUP WHEN PAGE CLOSES / RELOADS
        // =====================================================

        window.addEventListener(
            'beforeunload',
            function () {

                if (
                    connection.state !==
                    signalR.HubConnectionState.Disconnected
                ) {

                    connection.stop()
                        .then(function () {

                            console.log(
                                "SignalR stopped."
                            );

                        })
                        .catch(function (error) {

                            console.warn(
                                "Lỗi khi stop SignalR:",
                                error
                            );

                        });

                }

            }
        );


        // =====================================================
        // 12. EXPOSE CONNECTION FOR DEBUGGING
        // =====================================================

        window.notificationHubConnection =
            connection;

    });
</script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
