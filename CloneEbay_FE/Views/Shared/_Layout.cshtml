@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? username;
    var accessToken = HttpContextAccessor.HttpContext?.Session.GetString("AccessToken") ?? HttpContextAccessor.HttpContext?.Request.Cookies["AccessToken"];
    var isLoggedIn = !string.IsNullOrEmpty(username);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CloneEbay</title>
    <!-- Google Fonts & Bootstrap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- SignalR JS Client CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --bg-page: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        /* Top Navbar */
        .app-header {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-text {
            font-size: 24px;
            font-weight: 800;
            text-decoration: none;
            color: #0f172a;
            letter-spacing: -0.5px;
        }
        .brand-text .dot { color: var(--primary); }

        .nav-link-custom {
            color: var(--text-muted);
            font-weight: 500;
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 8px;
            transition: all 0.15s ease;
        }
        .nav-link-custom:hover {
            color: var(--primary);
            background-color: #f1f5f9;
        }

        /* Main Container */
        .main-container {
            flex: 1;
            padding-top: 30px;
            padding-bottom: 50px;
        }

        /* Form Card */
        .simple-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            padding: 32px;
        }

        .form-label {
            font-weight: 600;
            font-size: 14px;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            border: 1.5px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14.5px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .btn-main {
            background-color: var(--primary);
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
            padding: 11px 20px;
            border-radius: 8px;
            border: none;
            transition: background-color 0.15s ease;
            width: 100%;
        }
        .btn-main:hover {
            background-color: var(--primary-hover);
            color: #ffffff;
        }

        .btn-outline-main {
            border: 1.5px solid var(--border-color);
            background: #ffffff;
            color: var(--text-main);
            font-weight: 600;
            padding: 9px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s ease;
        }
        .btn-outline-main:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: #f8fafc;
        }

        /* Footer */
        .app-footer {
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            padding: 20px 0;
            font-size: 13.5px;
            color: var(--text-muted);
            text-align: center;
        }

        .fs-7 { font-size: 12px; }
        .cursor-pointer { cursor: pointer; }
    </style>
</head>
<body>
    <!-- Header Navigation -->
    <header class="app-header py-2">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand-text d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bag-check-fill text-primary me-1 fs-4"></i> CloneEbay<span class="dot">.</span>
            </a>

            <!-- Navigation Links -->
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Products" asp-action="Index" class="nav-link-custom">Sản phẩm</a>
                <a asp-controller="Cart" asp-action="Index" class="nav-link-custom"><i class="bi bi-cart3"></i> Giỏ hàng</a>
                <a asp-controller="Coupon" asp-action="Index" class="nav-link-custom d-none d-md-flex align-items-center gap-1">
                    <i class="bi bi-ticket-perforated text-primary"></i> Mã giảm giá
                </a>
                <a asp-controller="Review" asp-action="Index" class="nav-link-custom d-none d-md-flex align-items-center gap-1">
                    <i class="bi bi-star text-warning"></i> Đánh giá
                </a>

                @if (isLoggedIn)
                {
                    <a asp-controller="ReturnRequest" asp-action="Index" class="nav-link-custom d-none d-md-flex align-items-center gap-1">
                        <i class="bi bi-arrow-return-left text-primary"></i> Hoàn trả
                    </a>

                    <!-- Bell Notification Icon with Badge -->
                    <a asp-controller="Notification" asp-action="Index" class="nav-link-custom position-relative me-2 d-flex align-items-center justify-content-center p-2 rounded-circle hover-bg-light" title="Thông báo hệ thống">
                        <i class="bi bi-bell fs-5 text-primary"></i>
                        <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger fs-7 d-none">0</span>
                    </a>

                    <a asp-controller="Address" asp-action="Index" class="nav-link-custom d-none d-lg-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt fs-5 text-primary"></i>
                        <span>Địa chỉ</span>
                    </a>
                    <a asp-controller="Profile" asp-action="Index" class="nav-link-custom d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle fs-5 text-primary"></i>
                        <span>@fullName</span>
                    </a>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-danger rounded-3 ms-2 px-3 py-1">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="nav-link-custom">
                        Đăng nhập
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-sm btn-primary rounded-3 px-3 py-2 fw-semibold">
                        Đăng ký tài khoản
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Real-time SignalR Toast Notification Popup Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="liveNotifToast" class="toast align-items-center text-white bg-primary border-0 shadow-lg rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 fs-6">
                    <i class="bi bi-bell-fill fs-5" id="toastIcon"></i>
                    <div id="toastMessage">Thông báo mới từ hệ thống!</div>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Main Body Container -->
    <main class="main-container">
        <div class="container">
            <!-- Alert Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2 fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle-fill me-2 fs-5 text-warning"></i>
                    <div>@TempData["WarningMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container">
            <span>&copy; 2026 CloneEbay E-Commerce &bull; Hệ thống mua bán & đấu giá trực tuyến</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- SignalR Real-time Connection Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const userAccessToken = "@accessToken";

            if (userAccessToken && typeof signalR !== 'undefined') {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("http://localhost:5180/hubs/notification?access_token=" + encodeURIComponent(userAccessToken))
                    .withAutomaticReconnect()
                    .build();

                function handleIncomingNotification(data, type, iconClass, toastBg) {
                    // Show Toast Popup
                    const toastEl = document.getElementById('liveNotifToast');
                    const toastMsg = document.getElementById('toastMessage');
                    const toastIcon = document.getElementById('toastIcon');

                    if (toastMsg && toastEl) {
                        toastMsg.textContent = data.message || 'Thông báo mới!';
                        if (toastIcon) toastIcon.className = 'bi ' + iconClass + ' fs-5';
                        toastEl.className = 'toast align-items-center text-white border-0 shadow-lg ' + toastBg;

                        const bsToast = new bootstrap.Toast(toastEl, { delay: 5000 });
                        bsToast.show();
                    }

                    // Increment Badge
                    const badge = document.getElementById('notifBadge');
                    if (badge) {
                        let currentCount = parseInt(badge.textContent) || 0;
                        currentCount++;
                        badge.textContent = currentCount;
                        badge.classList.remove('d-none');
                    }

                    // Save History to LocalStorage
                    const history = JSON.parse(localStorage.getItem('cloneEbay_notifications') || '[]');
                    history.unshift({
                        type: type,
                        message: data.message || '',
                        time: new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                    });
                    localStorage.setItem('cloneEbay_notifications', JSON.stringify(history));
                }

                connection.on("ReceiveOrderNotification", function (data) {
                    handleIncomingNotification(data, "Order", "bi-box-seam-fill", "bg-success");
                });

                connection.on("ReceivePromotionNotification", function (data) {
                    handleIncomingNotification(data, "Promotion", "bi-ticket-perforated-fill", "bg-warning text-dark");
                });

                connection.on("ReceiveFeedbackNotification", function (data) {
                    handleIncomingNotification(data, "Feedback", "bi-chat-heart-fill", "bg-primary");
                });

                connection.start().then(function () {
                    console.log("SignalR Real-time NotificationHub connected successfully!");
                }).catch(function (err) {
                    console.warn("SignalR Connection Warning: ", err);
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
