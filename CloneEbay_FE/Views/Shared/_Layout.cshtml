@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? username;
    var isLoggedIn = !string.IsNullOrEmpty(username);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CloneEbay</title>
    <!-- Google Fonts & Bootstrap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --bg-page: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        /* Top Navbar */
        .app-header {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-text {
            font-size: 24px;
            font-weight: 800;
            text-decoration: none;
            color: #0f172a;
            letter-spacing: -0.5px;
        }
        .brand-text .dot { color: var(--primary); }

        .nav-link-custom {
            color: var(--text-muted);
            font-weight: 500;
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 8px;
            transition: all 0.15s ease;
        }
        .nav-link-custom:hover {
            color: var(--primary);
            background-color: #f1f5f9;
        }

        /* Main Container */
        .main-container {
            flex: 1;
            padding-top: 30px;
            padding-bottom: 50px;
        }

        /* Form Card */
        .simple-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            padding: 32px;
        }

        .form-label {
            font-weight: 600;
            font-size: 14px;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            border: 1.5px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 14.5px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .btn-main {
            background-color: var(--primary);
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
            padding: 11px 20px;
            border-radius: 8px;
            border: none;
            transition: background-color 0.15s ease;
            width: 100%;
        }
        .btn-main:hover {
            background-color: var(--primary-hover);
            color: #ffffff;
        }

        .btn-outline-main {
            border: 1.5px solid var(--border-color);
            background: #ffffff;
            color: var(--text-main);
            font-weight: 600;
            padding: 9px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s ease;
        }
        .btn-outline-main:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: #f8fafc;
        }

        /* Footer */
        .app-footer {
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            padding: 20px 0;
            font-size: 13.5px;
            color: var(--text-muted);
            text-align: center;
        }
    </style>
</head>
<body>
    <!-- Header Navigation -->
    <header class="app-header py-2">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand-text d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bag-check-fill text-primary me-1 fs-4"></i> CloneEbay<span class="dot">.</span>
            </a>

            <div class="d-flex align-items-center gap-2">
                @if (isLoggedIn)
                {
                    <a asp-controller="Profile" asp-action="Index" class="nav-link-custom d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle fs-5 text-primary"></i>
                        <span>@fullName</span>
                    </a>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-danger rounded-3 ms-2 px-3 py-1">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="nav-link-custom">
                        Đăng nhập
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-sm btn-primary rounded-3 px-3 py-2 fw-semibold">
                        Đăng ký tài khoản
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Main Body Container -->
    <main class="main-container">
        <div class="container">
            <!-- Alert Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2 fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle-fill me-2 fs-5 text-warning"></i>
                    <div>@TempData["WarningMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container">
            <span>&copy; 2026 CloneEbay E-Commerce &bull; Hệ thống mua bán & đấu giá trực tuyến</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
