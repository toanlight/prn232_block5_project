@model CloneEbay_FE.Models.PayPalPaymentViewModel
@{
    ViewData["Title"] = "Thanh toán thất bại";
}
<partial name="_PaymentMobileStyles" />

<div class="mx-auto" style="max-width: 650px">
    <div class="card border-0 shadow-sm text-center">
        <div class="card-body p-4 p-md-5">
            <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:76px;height:76px">
                <i class="bi bi-x-lg fs-1"></i>
            </div>
            <h1 class="h3">Thanh toán không thành công</h1>
            <p class="text-muted">Giao dịch PayPal cho đơn hàng <strong class="text-dark">#@Model.OrderId</strong> đã bị huỷ.</p>
            <div class="bg-light rounded-3 p-3 my-4 text-start">
                <div class="d-flex justify-content-between mb-2"><span>Trạng thái thanh toán</span><strong class="text-danger">Thất bại</strong></div>
                <div class="d-flex justify-content-between"><span>Tổng thanh toán</span><strong>@Model.Amount.ToString("N0") ₫</strong></div>
            </div>
            <p class="small text-muted">Tồn kho đã được hoàn lại. Sản phẩm mua trực tiếp đã được khôi phục vào giỏ hàng.</p>
            <div class="d-grid d-sm-flex justify-content-sm-center gap-2 mt-4">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-primary"><i class="bi bi-cart3"></i> Quay lại giỏ hàng</a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
            </div>
        </div>
    </div>
</div>
