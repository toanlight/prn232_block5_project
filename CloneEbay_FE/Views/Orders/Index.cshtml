@model List<CloneEbay_FE.Models.OrderHistoryItemViewModel>
@{
    ViewData["Title"] = "Lịch sử đặt hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-bag-check text-primary"></i> Đơn hàng của tôi</h1>
        <p class="text-muted mb-0">Quản lý và theo dõi trạng thái các đơn hàng đã đặt</p>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-cart-plus"></i> Tiếp tục mua sắm
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
        <i class="bi bi-box2 fs-1 text-muted"></i>
        <h5 class="mt-3 mb-2 fw-semibold">Bạn chưa có đơn hàng nào</h5>
        <p class="text-muted small">Hãy khám phá hàng ngàn sản phẩm tuyệt vời và đặt hàng ngay hôm nay!</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-2">
            Khám phá sản phẩm
        </a>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var order in Model)
        {
            var badgeClass = order.Status switch
            {
                "Confirmed" => "bg-success",
                "Pending" => "bg-warning text-dark",
                "Processing" => "bg-info text-dark",
                "Shipped" => "bg-primary",
                "Delivered" => "bg-success",
                "Cancelled" => "bg-danger",
                _ => "bg-secondary"
            };

            var statusText = order.Status switch
            {
                "Confirmed" => "Đã xác nhận",
                "Pending" => "Chờ thanh toán",
                "Processing" => "Đang xử lý",
                "Shipped" => "Đang giao hàng",
                "Delivered" => "Đã giao hàng",
                "Cancelled" => "Đã hủy",
                _ => order.Status
            };

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden order-card">
                <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold fs-6">Đơn hàng #@order.OrderId</span>
                        <span class="text-muted small">&bull; @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @badgeClass rounded-pill px-3 py-2">
                            <i class="bi bi-dot"></i> @statusText
                        </span>
                    </div>
                </div>

                <div class="card-body p-3">
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in order.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ratio ratio-1x1 bg-light rounded-3 overflow-hidden flex-shrink-0" style="width: 60px; height: 60px;">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="object-fit-cover w-100 h-100" alt="@item.Title" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark fw-semibold line-clamp-1 mb-1">
                                            @item.Title
                                        </a>
                                        <div class="text-muted small">
                                            Số lượng: <span class="fw-semibold text-dark">x@(item.Quantity)</span> &bull; Đơn giá: @item.UnitPrice.ToString("N0") ₫
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end fw-bold text-dark flex-shrink-0">
                                    @item.LineTotal.ToString("N0") ₫
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-footer bg-light border-0 p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="small text-muted">
                        Phương thức: <span class="fw-semibold text-dark">@order.PaymentMethod</span>
                        @if (!string.IsNullOrEmpty(order.AddressText))
                        {
                            <span class="d-none d-md-inline ms-2">&bull; Giao tới: @order.AddressText</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end">
                            <span class="small text-muted">Tổng tiền:</span>
                            <span class="fs-5 fw-bold text-danger ms-1">@order.TotalPrice.ToString("N0") ₫</span>
                        </div>
                        <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-outline-primary btn-sm px-3 rounded-3">
                            Chi tiết <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .order-card { transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .order-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important; }
    .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
</style>
