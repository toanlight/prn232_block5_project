@model CloneEbay_FE.Models.OrderHistoryItemViewModel
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.OrderId}";
    var badgeClass = Model.Status switch
    {
        "Confirmed" => "bg-success-subtle text-success border border-success-subtle",
        "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "Processing" => "bg-info-subtle text-info-emphasis border border-info-subtle",
        "Shipped" => "bg-primary-subtle text-primary border border-primary-subtle",
        "Delivered" => "bg-primary text-white",
        "Received" => "bg-success text-white",
        "Cancelled" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-secondary text-white"
    };

    var statusText = Model.Status switch
    {
        "Confirmed" => "Đã xác nhận",
        "Pending" => "Chờ thanh toán",
        "Processing" => "Đang xử lý",
        "Shipped" => "Đang giao hàng",
        "Delivered" => "Đã giao hàng",
        "Received" => "Đã nhận hàng",
        "Cancelled" => "Đã hủy",
        _ => Model.Status
    };
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn hàng
    </a>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Đơn hàng #@Model.OrderId</h1>
        <p class="text-muted mb-0">Đặt ngày @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
    </div>
    <span class="badge @badgeClass rounded-pill px-3 py-2 fs-6">
        @statusText
    </span>
</div>

<div class="row g-4">
    <!-- Cột trái: Danh sách sản phẩm & Thông tin giao hàng -->
    <div class="col-12 col-lg-8">
        <!-- Danh sách sản phẩm -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-white border-bottom p-3">
                <h2 class="h6 mb-0 fw-bold"><i class="bi bi-box-seam text-primary me-2"></i>Sản phẩm đã đặt (@Model.ItemCount món)</h2>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Tạm tính</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="ratio ratio-1x1 bg-light rounded-3 overflow-hidden flex-shrink-0" style="width: 50px; height: 50px;">
                                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" class="object-fit-cover w-100 h-100" alt="@item.Title" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                                        <i class="bi bi-image"></i>
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark fw-semibold">
                                                    @item.Title
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center text-muted">@item.UnitPrice.ToString("N0") ₫</td>
                                    <td class="text-center fw-semibold">@(item.Quantity)</td>
                                    <td class="text-end fw-bold text-dark">@item.LineTotal.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Thông tin giao hàng & người nhận -->
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-geo-alt text-primary me-2"></i>Địa chỉ nhận hàng</h2>
            <div class="bg-light rounded-3 p-3">
                <div class="fw-bold fs-6 mb-1">@(Model.RecipientName ?? "Khách hàng")</div>
                @if (!string.IsNullOrEmpty(Model.RecipientPhone))
                {
                    <div class="text-muted small mb-1"><i class="bi bi-telephone me-1"></i>@Model.RecipientPhone</div>
                }
                <div class="text-secondary small"><i class="bi bi-house-door me-1"></i>@(Model.AddressText ?? "Chưa có thông tin địa chỉ chi tiết")</div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Tóm tắt thanh toán -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-receipt text-primary me-2"></i>Thanh toán</h2>

            <div class="d-flex justify-content-between mb-2 small text-muted">
                <span>Tiền hàng:</span>
                <span class="fw-semibold text-dark">@Model.Subtotal.ToString("N0") ₫</span>
            </div>

            <div class="d-flex justify-content-between mb-3 small text-muted">
                <span>Phí vận chuyển:</span>
                <span class="fw-semibold text-dark">@Model.ShippingFee.ToString("N0") ₫</span>
            </div>

            <hr class="my-2" />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-bold">Tổng thanh toán:</span>
                <span class="fs-4 fw-bold text-danger">@Model.TotalPrice.ToString("N0") ₫</span>
            </div>

            <div class="bg-light rounded-3 p-3 mb-4">
                <div class="small text-muted mb-1">Hình thức thanh toán:</div>
                <div class="fw-bold text-primary"><i class="bi bi-credit-card me-1"></i>@Model.PaymentMethod</div>
                <div class="small text-muted mt-2">Trạng thái thanh toán:</div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 mt-1">
                    @Model.PaymentStatus
                </span>
            </div>

            <div class="d-flex flex-column gap-2 mb-3">
                @if (Model.Status != "Received" && Model.Status != "Cancelled")
                {
                    <form asp-action="ConfirmReceived" asp-route-id="@Model.OrderId" method="post" class="w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100 rounded-3">
                            <i class="bi bi-check2-circle me-1"></i> Đã nhận được hàng
                        </button>
                    </form>
                }

                @if (Model.Status != "Cancelled")
                {
                    <a asp-controller="ReturnRequest" asp-action="Create" asp-route-orderId="@Model.OrderId" class="btn btn-outline-danger w-100 rounded-3">
                        <i class="bi bi-arrow-return-left me-1"></i> Yêu cầu trả hàng / Hoàn tiền
                    </a>
                }
            </div>

            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary w-100 rounded-3">
                <i class="bi bi-bag me-1"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>
